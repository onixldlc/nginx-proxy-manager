# syntax=docker/dockerfile:1.7
#
# Dockerfile.build — self-contained build for CI (e.g. GitHub Actions).
#
# Unlike docker/Dockerfile, this file does NOT expect pre-built artifacts
# (frontend/dist, backend/node_modules) to exist in the build context.
# It builds them inline in dedicated stages, then assembles the final image.
#
# Intended to be built with `docker buildx` for multi-arch.
#
# Build args (optional):
#   BUILD_VERSION  - e.g. "2.14.0r1"
#   BUILD_COMMIT   - short git sha
#   BUILD_DATE     - ISO8601

# -----------------------------------------------------------------------------
# Stage 1: frontend build (produces /app/dist)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS frontend-builder
WORKDIR /app

ENV NODE_OPTIONS="--max_old_space_size=2048 --openssl-legacy-provider"

COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY frontend/ ./
RUN yarn locale-compile \
    && yarn build


# -----------------------------------------------------------------------------
# Stage 2: backend prep (just stages the source; deps installed in final stage
# because some native modules need the target platform's libs)
# -----------------------------------------------------------------------------
FROM alpine:3.20 AS backend-src
WORKDIR /src
COPY backend/ ./


# -----------------------------------------------------------------------------
# Stage 3: testca (for bundled root CA cert, same as upstream Dockerfile)
# -----------------------------------------------------------------------------
FROM docker.io/nginxproxymanager/testca:latest AS testca


# -----------------------------------------------------------------------------
# Stage 4: final image (mirrors upstream docker/Dockerfile)
# -----------------------------------------------------------------------------
FROM nginxproxymanager/nginx-full:certbot-node

ARG TARGETPLATFORM
ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_DATE

LABEL org.label-schema.schema-version="1.0" \
      org.label-schema.license="MIT" \
      org.label-schema.name="nginx-proxy-manager" \
      org.label-schema.description="Docker container for managing Nginx proxy hosts with a simple, powerful interface" \
      org.label-schema.url="https://github.com/onixldlc/nginx-proxy-manager" \
      org.label-schema.vcs-url="https://github.com/onixldlc/nginx-proxy-manager.git" \
      org.label-schema.cmd="docker run --rm -ti ghcr.io/onixldlc/nginx-proxy-manager:latest"

# See: https://github.com/just-containers/s6-overlay/blob/master/README.md
ENV SUPPRESS_NO_CONFIG_WARNING=1 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=1 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_FIX_ATTRS_HIDDEN=1 \
    S6_KILL_FINISH_MAXTIME=10000 \
    S6_VERBOSITY=1 \
    NODE_ENV=production \
    NPM_BUILD_VERSION="${BUILD_VERSION}" \
    NPM_BUILD_COMMIT="${BUILD_COMMIT}" \
    NPM_BUILD_DATE="${BUILD_DATE}" \
    NODE_OPTIONS="--openssl-legacy-provider"

RUN echo "fs.file-max = 65535" > /etc/sysctl.conf \
    && apt-get update \
    && apt-get install -y --no-install-recommends jq logrotate \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# s6 overlay
COPY docker/scripts/install-s6 /tmp/install-s6
RUN /tmp/install-s6 "${TARGETPLATFORM}" && rm -f /tmp/install-s6

EXPOSE 80 81 443

# App: backend source + compiled frontend from builder stage
COPY --from=backend-src    /src       /app
COPY --from=frontend-builder /app/dist /app/frontend

WORKDIR /app
RUN yarn install \
    && yarn cache clean

# add late to limit cache-busting by modifications
COPY docker/rootfs /
COPY --from=testca /home/step/certs/root_ca.crt /etc/ssl/certs/NginxProxyManager.crt

# Remove frontend service not required for prod, dev nginx config as well
RUN rm -rf /etc/s6-overlay/s6-rc.d/user/contents.d/frontend /etc/nginx/conf.d/dev.conf \
    && chmod 644 /etc/logrotate.d/nginx-proxy-manager

VOLUME [ "/data" ]
ENTRYPOINT [ "/init" ]